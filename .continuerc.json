{
  "mergeBehavior": "merge",
  "models": [
    {
      "title": "LLaMA 3.1",
      "provider": "ollama",
      "model": "llama3.1:latest",
      "apiBase": "http://localhost:11434",
      "contextLength": 8192
    }
  ],
  "contextProviders": [
    {
      "name": "files",
      "params": {
        "include": [
          "**/*.js",
          "**/*.ts",
          "**/*.tsx",
          "**/*.py",
          "**/*.json"
        ],
        "exclude": [
          "node_modules/**",
          "dist/**",
          "build/**",
          ".git/**",
          "*.log"
        ]
      }
    }
  ],
  "embeddingsProvider": {
    "provider": "ollama",
    "model": "nomic-embed-text"
  },
  "tabAutocompleteModel": {
    "title": "LLaMA 3.1",
    "provider": "ollama",
    "model": "llama3.1:latest",
    "apiBase": "http://localhost:11434"
  },
  "slashCommands": [
    {
      "name": "agent",
      "description": "Use LLaMA 3.1 in agentic mode",
      "model": "llama3.1:latest"
    }
  ]
}